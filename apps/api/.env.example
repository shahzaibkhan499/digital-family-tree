# ============================================
# Digital Family Tree - Environment Variables
# ============================================
# REQUIRED: Generate secure secrets for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digital_family_tree?schema=public"

# JWT Secrets - REQUIRED, app will NOT start without these
JWT_SECRET="CHANGE_ME_GENERATE_A_64_BYTE_RANDOM_HEX_STRING"
JWT_REFRESH_SECRET="CHANGE_ME_GENERATE_A_DIFFERENT_64_BYTE_RANDOM_HEX_STRING"
JWT_EXPIRATION="1h"
JWT_REFRESH_EXPIRATION="30d"

# Neo4j Graph Database - REQUIRED for graph features (relationship engine, common ancestor, etc.)
# ================================================================================
# Sign up for Neo4j AuraDB free tier: https://console.neo4j.io/
# Or use local Docker: docker run -p 7687:7687 -e NEO4J_AUTH=neo4j/password neo4j:5
# ================================================================================
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD=""

# Redis (Optional - currently unused in codebase)
# REDIS_URL="redis://localhost:6379"

# Admin Panel Key - CHANGE THIS IN PRODUCTION
ADMIN_API_KEY="dft-admin-secret-key-2024"

# App URLs
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WEB_URL="http://localhost:4001"
