  industry           String?
  legalStructure     String?
  registrationDate   DateTime?
  registrationNumber String?
  taxId              String?
  address            String?
  city               String?
  country            String?
  website            String?
  initialInvestment  Float?
  investmentCurrency String?
  fundingSource      String?
  coFounders         Json?
  partners           Json?
  employees          Int?
  productService     String?
  targetMarket       String?
  annualRevenue      Float?
  revenueCurrency    String?
  profitMargin       Float?
  isOpen             Boolean       @default(true)
  closeDate          DateTime?
  closeReason        String?
  acquisitionDetails Json?
  mergerDetails      Json?
  milestones         Json?
  achievements       Json?
  licenses           Json?
  certifications     Json?
  permits            Json?
  metadata           Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  event              TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventSummary {
  id             String        @id @default(uuid())
  eventId        String        @unique
  generatedText  String
  summaryType    String        @default("AUTO")
  language       String        @default("en")
  version        Int           @default(1)
  keyFacts       Json?
  timeline       Json?
  isEdited       Boolean       @default(false)
  editedText     String?
  editedById     String?
  narrativeStyle String?
  tone           String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  event          TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventPrintVersion {
  id               String        @id @default(uuid())
  eventId          String        @unique
  versionType      String        @default("STANDARD")
  htmlContent      String?
  pdfUrl           String?
  includeMap       Boolean       @default(true)
  includeTimeline  Boolean       @default(true)
  includePhotos    Boolean       @default(true)
  includeDocuments Boolean       @default(false)
  includeGuests    Boolean       @default(false)
  colorScheme      String?       @default("default")
  fontFamily       String?       @default("serif")
  layout           String?       @default("portrait")
  generatedById    String?
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  userId           String?
  event            TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  User             User?         @relation(fields: [userId], references: [id])

  @@index([eventId])
}

model EventAttendance {
  id           String        @id @default(uuid())
  eventId      String
  userId       String
  method       String        @default("MANUAL")
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  location     Json?
  verified     Boolean       @default(false)
  verifiedById String?
  verifiedAt   DateTime?
  qrCode       String?
  qrScannedAt  DateTime?
  notes        String?
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  event        TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([method])
}

model EventVersion {
  id                String        @id @default(uuid())
  displayId         String        @unique @default("")
  eventId           String
  userId            String
  versionNumber     Int
  changeType        String        @default("UPDATE")
  changeDescription String?
  snapshot          Json
  isRollback        Boolean       @default(false)
  rolledBackFromId  String?
  createdAt         DateTime      @default(now())
  event             TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user              User          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([userId])
  @@index([eventId, versionNumber])
}

model EventCustomTemplate {
  id          String   @id @default(uuid())
  displayId   String   @unique @default("")
  userId      String
  name        String
  eventType   String
  description String?
  config      Json
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventType])
}

model EventReaction {
  id        String        @id @default(uuid())
  eventId   String
  userId    String
  emoji     String
  createdAt DateTime      @default(now())
  event     TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId, emoji])
  @@index([eventId])
  @@index([userId])
}

model EventSearchTag {
  id        String        @id @default(uuid())
  eventId   String
  tag       String
  category  String        @default("general")
  createdAt DateTime      @default(now())
  event     TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, tag])
  @@index([eventId])
  @@index([tag])
  @@index([category])
}

model EventHistory {
  id        String        @id @default(uuid())
  displayId String        @unique @default("")
  eventId   String
  userId    String
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  metadata  Json?
  createdAt DateTime      @default(now())
  event     TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model EventDocument {
  id                 String        @id @default(uuid())
  displayId          String        @unique @default("")
  eventId            String
  uploadedById       String?
  ownerId            String?
  fileName           String
  fileType           String
  fileSize           Int?
  fileUrl            String
  title              String?
  description        String?
  verificationStatus String        @default("UNVERIFIED")
  issueDate          DateTime?
  expiryDate         DateTime?
  privacy            String        @default("FAMILY")
  version            Int           @default(1)
  isPublic           Boolean       @default(false)
  tags               String[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  category           String        @default("GENERAL")
  downloadCount      Int           @default(0)
  isPrivate          Boolean       @default(false)
  metadata           Json?
  ocrStatus          String        @default("NOT_APPLICABLE")
  ocrText            String?
  originalUrl        String?
  thumbnailUrl       String?
  verificationNotes  String?
  verifiedAt         DateTime?
  verifiedById       String?
  virusScanStatus    String        @default("PENDING")
  event              TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  owner              User?         @relation("EventDocOwner", fields: [ownerId], references: [id])
  uploadedBy         User?         @relation("EventDocUploader", fields: [uploadedById], references: [id])
  verifiedBy         User?         @relation("EventDocVerifier", fields: [verifiedById], references: [id])

  @@index([eventId])
  @@index([uploadedById])
  @@index([ownerId])
  @@index([verificationStatus])
  @@index([fileType])
}

model EventActivity {
  id          String        @id @default(uuid())
  displayId   String        @unique @default("")
  eventId     String
  userId      String?
  action      String
  description String?
  metadata    Json?
  createdAt   DateTime      @default(now())
  event       TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User?         @relation(fields: [userId], references: [id])

  @@index([eventId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ProfileLink {
  id        String   @id @default(cuid())
  userId    String   @unique
  memberId  String   @unique
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([memberId])
}
