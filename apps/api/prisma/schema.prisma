generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                   @id @default(uuid())
  displayId                  String                   @unique @default("")
  email                      String                   @unique
  name                       String
  password                   String
  role                       String                   @default("USER")
  plan                       String                   @default("free")
  refreshToken               String?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  username                   String?                  @unique
  profileSlug                String?                  @unique
  emailVerified              Boolean                  @default(false)
  accountStatus              String                   @default("active")
  lastLoginAt                DateTime?
  deletedAt                  DateTime?
  firstName                  String?
  middleName                 String?
  lastName                   String?
  displayName                String?
  nickname                   String?
  gender                     String?
  dateOfBirth                DateTime?
  placeOfBirth               String?
  bloodGroup                 String?
  maritalStatus              String?
  nationality                String?
  religion                   String?
  languages                  String?
  governmentId               String?
  phone                      String?
  whatsapp                   String?
  alternativePhone           String?
  country                    String?
  province                   String?
  city                       String?
  postalCode                 String?
  fullAddress                String?
  bio                        String?
  occupation                 String?
  company                    String?
  education                  String?
  skills                     String?
  interests                  String?
  website                    String?
  socialLinks                String?
  fatherId                   String?
  motherId                   String?
  spouseId                   String?
  childrenIds                String?
  siblingIds                 String?
  avatar                     String?
  coverPhoto                 String?
  privacySettings            String?
  locale                     String?                  @default("en")
  timezone                   String?                  @default("UTC")
  twoFactorEnabled           Boolean                  @default(false)
  twoFactorSecret            String?
  failedLoginAttempts        Int                      @default(0)
  lockedUntil                DateTime?
  resetTokenHash             String?
  resetTokenExpiresAt        DateTime?
  theme                      String?                  @default("system")
  activities                 Activity[]
  activityComments           ActivityComment[]
  activityReactions          ActivityReaction[]
  auditLogs                  AuditLog[]
  bookmarks                  Bookmark[]
  clans                      Clan[]
  clanAdminGrants            ClanAdmin[]              @relation("ClanAdminGrants")
  clanAdmins                 ClanAdmin[]
  clanDirectory              ClanDirectory[]
  clanDirectoryVerified      ClanDirectory[]          @relation("ClanDirVerified")
  clanDocuments              ClanDocument[]
  clanEvents                 ClanEvent[]
  clanFollowers              ClanFollower[]
  clanGalleryItems           ClanGallery[]
  ClanHistory                ClanHistory[]
  clanHistoryEntries         ClanHistoryEntry[]       @relation("ClanHistoryEditor")
  moderatedHistories         ClanHistoryEntry[]       @relation("ClanHistoryModerator")
  clanRequests               ClanRequest[]            @relation("ClanRequestsMade")
  clanRequestsReviewed       ClanRequest[]            @relation("ClanRequestsReviewed")
  communities                Community[]
  communityAdminGrants       CommunityAdmin[]         @relation("CommunityAdminGrants")
  communityAdmins            CommunityAdmin[]
  communityDirectory         CommunityDirectory[]
  communityDirectoryVerified CommunityDirectory[]     @relation("CommunityDirVerified")
  communityDocuments         CommunityDocument[]
  communityEvents            CommunityEvent[]
  communityFollowers         CommunityFollower[]
  communityGalleryItems      CommunityGallery[]
  communityHistories         CommunityHistory[]
  communityNews              CommunityNews[]
  communityRequestsMade      CommunityRequest[]       @relation("CommunityRequestsMade")
  communityRequestsReviewed  CommunityRequest[]       @relation("CommunityRequestsReviewed")
  documentAccessLogs         DocumentAccessLog[]      @relation("DocAccessUser")
  vaultAttachments           DocumentAttachment[]
  vaultCollections           DocumentCollection[]
  documentCollectionItems    DocumentCollectionItem[]
  documentFolders            DocumentFolder[]
  vaultGallery               DocumentGallery[]
  vaultKnowledgeBase         DocumentKnowledgeBase[]
  vaultReferences            DocumentReference[]
  documentSharedBy           DocumentShare[]          @relation("ShareBy")
  documentSharedWith         DocumentShare[]          @relation("ShareWith")
  vaultDocuments             DocumentVault[]          @relation("VaultOwner")
  vaultUploads               DocumentVault[]          @relation("VaultUploader")
  documentVerifiers          DocumentVerification[]
  documentVersions           DocumentVersion[]
  eventActivities            EventActivity[]
  EventAttendance            EventAttendance[]
  eventComments              EventComment[]
  eventCustomTemplates       EventCustomTemplate[]
  eventDocumentsOwner        EventDocument[]          @relation("EventDocOwner")
  eventDocumentsUploaded     EventDocument[]          @relation("EventDocUploader")
  verifiedEvents             EventDocument[]          @relation("EventDocVerifier")
  eventHistoryEntries        EventHistory[]
  eventInvitationsSent       EventInvitation[]        @relation("EventInvitationsSent")
  eventInvitations           EventInvitation[]        @relation("EventInvitations")
  eventParticipants          EventParticipant[]
  printVersions              EventPrintVersion[]
  eventReactions             EventReaction[]
  eventVersions              EventVersion[]
  families                   Family[]
  mergeRequestsReceived      FamilyMergeRequest[]     @relation("MergeApprover")
  mergeRequestsSent          FamilyMergeRequest[]     @relation("MergeRequester")
  invitationsSent            Invitation[]             @relation("InvitedBy")
  knowledgeBaseEntries       KnowledgeBase[]
  sessions                   LoginSession[]
  memories                   Memory[]
  memoryComments             MemoryComment[]
  memoryReactions            MemoryReaction[]
  notifications              Notification[]
  notificationAuditLogs      NotificationAuditLog[]   @relation("AuditPerformer")
  notificationDeliveries     NotificationDelivery[]
  notificationPreferences    NotificationPreference?
  notificationQueueItems     NotificationQueue[]      @relation("QueueUser")
  fieldPrivacy               ProfileFieldPrivacy[]
  subClans                   SubClan[]
  eventCreatedEvents         TimelineEvent[]          @relation("EventCreator")
  treeBookmarks              TreeBookmark[]
  treeSearchHistory          TreeSearchHistory[]
  treeViews                  TreeView[]
  treeViewHistory            TreeViewHistory[]

  @@index([email])
  @@index([phone])
  @@index([city])
  @@index([country])
  @@index([name])
}

model LoginSession {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String?
  userAgent String?
  location  String?
  loggedAt  DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loggedAt])
}

model Family {
  id                String               @id @default(uuid())
  displayId         String               @unique @default("")
  name              String
  description       String?
  ownerId           String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  clanId            String?
  subClanId         String?
  deletedAt         DateTime?
  activities        Activity[]
  clanRequests      ClanRequest[]
  communityRequests CommunityRequest[]
  clan              Clan?                @relation(fields: [clanId], references: [id])
  owner             User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  subClan           SubClan?             @relation(fields: [subClanId], references: [id])
  members           FamilyMember[]
  mergeSent         FamilyMergeRequest[] @relation("SourceFamily")
  mergeReceived     FamilyMergeRequest[] @relation("TargetFamily")
  invitations       Invitation[]
  memories          Memory[]
  timelineEvents    TimelineEvent[]

  @@index([ownerId])
  @@index([clanId])
  @@index([name])
  @@index([subClanId])
  @@index([deletedAt])
}

model FamilyMember {
  id                String          @id @default(uuid())
  displayId         String          @unique @default("")
  sharedId          String?
  familyId          String
  firstName         String
  lastName          String
  middleName        String?
  nickname          String?
  birthDate         DateTime?
  deathDate         DateTime?
  gender            String?
  bio               String?
  avatar            String?
  email             String?
  phone             String?
  whatsapp          String?
  address           String?
  city              String?
  country           String?
  occupation        String?
  notes             String?
  governmentId      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  duplicateSource   DuplicatePair[] @relation("DuplicateSource")
  duplicateTarget   DuplicatePair[] @relation("DuplicateTarget")
  family            Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  memoryMembers     MemoryMember[]
  fromRelationships Relationship[]  @relation("FromMember")
  toRelationships   Relationship[]  @relation("ToMember")
  timelineEvents    TimelineEvent[]

  @@index([familyId])
  @@index([sharedId])
  @@index([displayId])
  @@index([email])
  @@index([phone])
  @@index([firstName, lastName])
  @@index([firstName, lastName, birthDate])
  @@index([governmentId])
  @@index([deletedAt])
}

model Relationship {
  id           String       @id @default(uuid())
  displayId    String       @unique @default("")
  fromMemberId String
  toMemberId   String
  type         String
  createdAt    DateTime     @default(now())
  fromMember   FamilyMember @relation("FromMember", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMember     FamilyMember @relation("ToMember", fields: [toMemberId], references: [id], onDelete: Cascade)

  @@unique([fromMemberId, toMemberId, type])
  @@index([fromMemberId])
  @@index([toMemberId])
  @@index([type])
}

model Activity {
  id          String             @id @default(uuid())
  userId      String
  familyId    String?
  entityType  String?
  entityId    String?
  entityName  String?
  createdAt   DateTime           @default(now())
  createdBy   String?
  description String?
  displayId   String             @unique @default("")
  eventType   String
  memberId    String?
  title       String
  updatedAt   DateTime           @updatedAt
  visibility  String             @default("FAMILY")
  metadata    Json?
  family      Family?            @relation(fields: [familyId], references: [id])
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments    ActivityComment[]
  media       ActivityMedia[]
  reactions   ActivityReaction[]

  @@index([userId])
  @@index([familyId])
  @@index([createdAt])
  @@index([eventType])
  @@index([visibility])
  @@index([userId, createdAt])
  @@index([familyId, createdAt])
  @@index([eventType, createdAt])
}

model ActivityMedia {
  id         String   @id @default(uuid())
  activityId String
  url        String
  type       String   @default("IMAGE")
  alt        String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
}

model ActivityComment {
  id         String   @id @default(uuid())
  activityId String
  userId     String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([activityId])
  @@index([userId])
  @@index([createdAt])
}

model ActivityReaction {
  id         String   @id @default(uuid())
  activityId String
  userId     String
  type       String   @default("LIKE")
  createdAt  DateTime @default(now())
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId, type])
  @@index([activityId])
  @@index([userId])
}

model Invitation {
  id          String   @id @default(uuid())
  familyId    String
  email       String
  role        String   @default("MEMBER")
  invitedById String
  token       String   @unique
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invitedBy   User     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([email])
  @@index([token])
  @@index([status])
}

model FamilyMergeRequest {
  id             String    @id @default(uuid())
  displayId      String    @unique @default("")
  sourceFamilyId String
  targetFamilyId String
  requesterId    String
  approverId     String?
  status         String    @default("PENDING")
  conflictData   String?
  metadata       String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  approver       User?     @relation("MergeApprover", fields: [approverId], references: [id])
  requester      User      @relation("MergeRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  sourceFamily   Family    @relation("SourceFamily", fields: [sourceFamilyId], references: [id], onDelete: Cascade)
  targetFamily   Family    @relation("TargetFamily", fields: [targetFamilyId], references: [id], onDelete: Cascade)

  @@index([sourceFamilyId])
  @@index([targetFamilyId])
  @@index([requesterId])
  @@index([status])
}

model MergeAuditLog {
  id             String   @id @default(uuid())
  mergeRequestId String
  action         String
  performedById  String
  details        String?
  createdAt      DateTime @default(now())

  @@index([mergeRequestId])
  @@index([performedById])
  @@index([createdAt])
}

model Notification {
  id         String                 @id @default(uuid())
  displayId  String                 @unique @default("")
  userId     String
  title      String
  message    String
  type       String
  category   String                 @default("GENERAL")
  priority   String                 @default("NORMAL")
  icon       String?
  actionUrl  String?
  metadata   Json?
  isRead     Boolean                @default(false)
  readAt     DateTime?
  isArchived Boolean                @default(false)
  createdBy  String?
  expiresAt  DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs  NotificationAuditLog[] @relation("AuditNotification")
  deliveries NotificationDelivery[]

  @@index([userId])
  @@index([type])
  @@index([category])
  @@index([priority])
  @@index([isRead])
  @@index([isArchived])
  @@index([createdAt])
  @@index([userId, isRead])
  @@index([userId, isArchived])
}

model NotificationPreference {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  emailNotifications      Boolean  @default(true)
  pushNotifications       Boolean  @default(true)
  inAppNotifications      Boolean  @default(true)
  birthdayReminders       Boolean  @default(true)
  anniversaryReminders    Boolean  @default(true)
  invitationNotifications Boolean  @default(true)
  familyUpdates           Boolean  @default(true)
  securityAlerts          Boolean  @default(true)
  adminAnnouncements      Boolean  @default(true)
  marketingEmails         Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationDelivery {
  id             String       @id @default(uuid())
  notificationId String
  userId         String
  channel        String
  status         String       @default("PENDING")
  attempts       Int          @default(0)
  lastAttemptAt  DateTime?
  deliveredAt    DateTime?
  errorMessage   String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([userId])
  @@index([channel])
  @@index([status])
  @@index([userId, channel])
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  type      String   @unique
  category  String   @default("GENERAL")
  title     String
  message   String
  icon      String?
  actionUrl String?
  priority  String   @default("NORMAL")
  isActive  Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([category])
  @@index([isActive])
}

model NotificationAuditLog {
  id             String       @id @default(uuid())
  notificationId String
  performedById  String
  action         String
  details        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  notification   Notification @relation("AuditNotification", fields: [notificationId], references: [id], onDelete: Cascade)
  performer      User         @relation("AuditPerformer", fields: [performedById], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([performedById])
  @@index([action])
  @@index([createdAt])
}

model NotificationQueue {
  id           String    @id @default(uuid())
  userId       String
  type         String
  category     String    @default("GENERAL")
  priority     String    @default("NORMAL")
  title        String
  message      String
  icon         String?
  actionUrl    String?
  metadata     Json?
  status       String    @default("PENDING")
  scheduledFor DateTime  @default(now())
  processedAt  DateTime?
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation("QueueUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([scheduledFor])
  @@index([status, scheduledFor])
}

model Memory {
  id          String           @id @default(uuid())
  displayId   String           @unique @default("")
  title       String
  description String?
  story       String?
  date        DateTime?
  location    String?
  visibility  String           @default("FAMILY")
  tags        String?
  isHidden    Boolean          @default(false)
  userId      String
  familyId    String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  clanId      String?
  communityId String?
  subClanId   String?
  clan        Clan?            @relation(fields: [clanId], references: [id])
  community   Community?       @relation(fields: [communityId], references: [id])
  family      Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  subClan     SubClan?         @relation(fields: [subClanId], references: [id])
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments    MemoryComment[]
  media       MemoryMedia[]
  members     MemoryMember[]
  reactions   MemoryReaction[]

  @@index([userId])
  @@index([familyId])
  @@index([date])
  @@index([visibility])
  @@index([isHidden])
  @@index([familyId, date])
  @@index([userId, createdAt])
  @@index([subClanId])
  @@index([clanId])
  @@index([communityId])
}

model MemoryMedia {
  id        String   @id @default(uuid())
  memoryId  String
  url       String
  type      String   @default("IMAGE")
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
}

model MemoryMember {
  id       String       @id @default(uuid())
  memoryId String
  memberId String
  member   FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memory   Memory       @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([memoryId, memberId])
  @@index([memoryId])
  @@index([memberId])
}

model MemoryComment {
  id        String   @id @default(uuid())
  memoryId  String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@index([userId])
  @@index([createdAt])
}

model MemoryReaction {
  id        String   @id @default(uuid())
  memoryId  String
  userId    String
  type      String   @default("LIKE")
  createdAt DateTime @default(now())
  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([memoryId, userId, type])
  @@index([memoryId])
  @@index([userId])
}

model TimelineEvent {
  id                 String                 @id @default(uuid())
  displayId          String                 @unique @default("")
  familyId           String
  memberId           String?
  eventType          String
  title              String
  description        String?
  date               DateTime?
  location           String?
  metadata           Json?
  isAuto             Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  color              String?
  coverImage         String?
  createdById        String?
  mapLink            String?
  status             String                 @default("UPCOMING")
  time               String?
  venue              String?
  clanId             String?
  communityId        String?
  subClanId          String?
  visibility         String                 @default("FAMILY")
  archived           Boolean                @default(false)
  cancellationReason String?
  cancelledAt        DateTime?
  category           String                 @default("Custom")
  coordinates        Json?
  country            String?
  deletedAt          DateTime?
  endDate            DateTime?
  featured           Boolean                @default(false)
  isAllDay           Boolean                @default(false)
  keywords           String[]
  language           String?
  maxAttendees       Int?
  parentEventId      String?
  pinned             Boolean                @default(false)
  publishedAt        DateTime?
  recurrence         String?
  recurrenceRule     String?
  rsvpDeadline       DateTime?
  scheduledAt        DateTime?
  seriesId           String?
  slug               String                 @unique @default("")
  subtitle           String?
  tags               String[]
  timezone           String?
  verified           Boolean                @default(false)
  awardInfo          AwardInformation?
  birthInfo          BirthInformation?
  businessInfo       BusinessInformation?
  deathInfo          DeathInformation?
  educationInfo      EducationInformation?
  employmentInfo     EmploymentInformation?
  activities         EventActivity[]
  EventAttendance    EventAttendance[]
  comments           EventComment[]
  documents          EventDocument[]
  history            EventHistory[]
  invitations        EventInvitation[]
  media              EventMedia[]
  participants       EventParticipant[]
  printVersions      EventPrintVersion?
  reactions          EventReaction[]
  reminders          EventReminder[]
  searchTags         EventSearchTag[]
  summary            EventSummary?
  versions           EventVersion[]
  marriageInfo       MarriageInformation?
  migrationInfo      MigrationInformation?
  militaryInfo       MilitaryInformation?
  clan               Clan?                  @relation(fields: [clanId], references: [id])
  community          Community?             @relation(fields: [communityId], references: [id])
  createdBy          User?                  @relation("EventCreator", fields: [createdById], references: [id])
  family             Family                 @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member             FamilyMember?          @relation(fields: [memberId], references: [id])
  subClan            SubClan?               @relation(fields: [subClanId], references: [id])

  @@index([familyId])
  @@index([memberId])
  @@index([eventType])
  @@index([category])
  @@index([date])
  @@index([status])
  @@index([familyId, date])
  @@index([eventType, date])
  @@index([familyId, status])
  @@index([visibility])
  @@index([subClanId])
  @@index([clanId])
  @@index([communityId])
  @@index([createdById])
  @@index([deletedAt])
  @@index([tags])
  @@index([seriesId])
  @@index([parentEventId])
}

model EventParticipant {
  id         String        @id @default(uuid())
  eventId    String
  userId     String
  rsvpStatus String        @default("PENDING")
  rsvpDate   DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  event      TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([rsvpStatus])
}

model EventReminder {
  id              String        @id @default(uuid())
  eventId         String
  userId          String
  reminderType    String
  scheduledAt     DateTime
  sent            Boolean       @default(false)
  sentAt          DateTime?
  createdAt       DateTime      @default(now())
  deliveryChannel String        @default("IN_APP")
  isRecurring     Boolean       @default(false)
  lastSentAt      DateTime?
  nextSendAt      DateTime?
  recurrenceRule  String?
  event           TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
  @@index([scheduledAt])
  @@index([sent, scheduledAt])
  @@index([nextSendAt])
}

model EventMedia {
  id             String        @id @default(uuid())
  eventId        String
  url            String
  type           String        @default("IMAGE")
  caption        String?
  order          Int           @default(0)
  createdAt      DateTime      @default(now())
  fileName       String?
  fileSize       Int?
  isDownloadable Boolean       @default(true)
  isFeatured     Boolean       @default(false)
  mimeType       String?
  thumbnailUrl   String?
  uploadedById   String?
  event          TimelineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([type])
}

model DuplicatePair {
  id              String       @id @default(uuid())
  displayId       String       @unique @default("")
  sourceMemberId  String
  targetMemberId  String
  confidenceScore Float
  matchFactors    Json
  status          String       @default("PENDING")
  reviewedById    String?
