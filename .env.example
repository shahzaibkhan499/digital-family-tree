# ============================================
# Digital Family Tree — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Generate secure secrets:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# App
NEXT_PUBLIC_APP_URL=http://localhost:4001
NEXT_PUBLIC_APP_NAME="Digital Family Tree"
NEXT_PUBLIC_APP_DESCRIPTION="A modern platform to discover, build, and preserve your family heritage"

# API
API_URL=http://localhost:4000
API_PORT=4000
API_PREFIX=api

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/digital_family_tree

# Neo4j Graph Database
# Sign up for Neo4j AuraDB free tier: https://console.neo4j.io/
# Or use local Docker: docker run -p 7687:7687 -e NEO4J_AUTH=neo4j/password neo4j:5
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

# Redis (Optional)
REDIS_URL=redis://localhost:6379

# JWT — Generate unique 64-byte hex secrets for each
JWT_SECRET=change-this-to-a-random-64-byte-hex-secret
JWT_REFRESH_SECRET=change-this-to-a-different-64-byte-hex-secret
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Password Reset
RESET_TOKEN_SECRET=change-this-to-another-random-64-byte-hex-secret
RESET_TOKEN_EXPIRATION=15m

# Admin
ADMIN_API_KEY=your-admin-api-key-here

# CORS — comma-separated origins
CORS_ORIGIN=http://localhost:4001,http://localhost:4002

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (Email)
RESEND_API_KEY=

# Node
NODE_ENV=development
